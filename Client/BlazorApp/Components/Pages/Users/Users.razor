@page "/users"
@inject IUserService UserService

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<div class="toolbar">
    <input placeholder="Username contains..." @bind="filter"/>
    <button class="btn" @onclick="LoadAsync">Search</button>
</div>

@if (!string.IsNullOrEmpty(errorLabel))
{
    <p class="error">@errorLabel</p>
}
else if (users is null)
{
    <p class="muted">Loading...</p>
}
else if (!users.Any())
{
    <p class="muted">No users found.</p>
}
else
{
    <ul class="list">
        @foreach (UserDto user in users)
        {
            <li>
                <span>@user.Username</span>
                <a class="muted" href="posts?userId=@user.Id">posts</a>
            </li>
        }
    </ul>
}

@code {
    private List<UserDto>? users;
    private string filter = "";
    private string errorLabel = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        errorLabel = "";
        try
        {
            users = (await UserService.GetUsersAsync(filter)).ToList();
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            errorLabel = $"Error: {e.Message}";
        }
    }
}
